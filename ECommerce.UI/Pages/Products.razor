@page "/products"
@inject HttpClient Http
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<PageTitle>Cloud Inventory & Checkout Pipeline</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0">📦 Modern Commerce Catalog Dashboard</h2>
            <p class="text-muted small mb-0">Infrastructure: Blazor WASM ➔ .NET Aspire ➔ RabbitMQ ➔ MassTransit Worker ➔ Neon PostgreSQL</p>
        </div>
        <span class="badge bg-dark p-2 fs-6 font-monospace">Event-Driven Architecture</span>
    </div>

    <!-- Notification Alert Box Tracker -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @alertClass alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <strong class="d-block mb-1">📢 Checkout Channel Feedback:</strong>
            <span class="small font-monospace">@statusMessage</span>
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    @if (products == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="text-muted">Streaming catalog matrices live from Neon Cloud cluster...</p>
        </div>
    }
    else if (!products.Any())
    {
        <div class="alert alert-warning text-center">No products found in the database. Ensure your DbSeeder script executed successfully.</div>
    }
    else
    {
        <div class="row">
            @foreach (var prod in products)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden transition-card">
                        <!-- Category Accent Banner -->
                        <span class="position-absolute top-0 end-0 badge bg-secondary m-2 text-uppercase font-monospace px-2 py-1" style="font-size: 0.65rem; z-index: 10;">
                            @prod.Category
                        </span>

                        <img src="@prod.ImageUrl" class="card-img-top w-100" alt="@prod.Name" style="height: 180px; object-fit: cover; background-color: #f8f9fa;">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold mb-1">@prod.Name</h5>
                            <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @prod.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="fs-4 fw-bold text-success">₹@prod.Price</span>
                                <span class="badge @(prod.StockQuantity > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") border px-2 py-1 rounded-pill">
                                    Stock: @prod.StockQuantity
                                </span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                            <button class="btn @(prod.StockQuantity > 0 ? "btn-primary" : "btn-outline-secondary") w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2"
                                    @onclick="() => TriggerAsyncCheckout(prod.Id)"
                                    disabled="@(prod.StockQuantity <= 0 || activeProcessingIds.Contains(prod.Id))">
                                @if (activeProcessingIds.Contains(prod.Id))
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Queuing...</span>
                                }
                                else if (prod.StockQuantity <= 0)
                                {
                                    <span>❌ Sold Out</span>
                                }
                                else
                                {
                                    <span>🛒 Instant Checkout</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ProductDisplayDto>? products;
    private HashSet<Guid> activeProcessingIds = new();
    private string statusMessage = string.Empty;
    private string alertClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        try
        {
            var backendUrl = Config["services:ecommerce-api:https:0"] ?? "https://localhost:7089";

            products = await Http.GetFromJsonAsync<List<ProductDisplayDto>>($"{backendUrl}/api/products");
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to render products catalog matrix: {ex.Message}";
            alertClass = "alert-danger";
        }
    }

    private async Task TriggerAsyncCheckout(Guid productId)
    {
        activeProcessingIds.Add(productId);
        statusMessage = "⏳ Creating integration event data context packet...";
        alertClass = "alert-info";

        try
        {
            var backendUrl = Config["services:ecommerce-api:https:0"] ?? "https://localhost:7089";

            var url = $"{backendUrl}/api/products/checkout?productId={productId}&quantity=1";

            // 2. Use PostAsync and pass null for the HTTP body content
            var response = await Http.PostAsync(url, null);

            if (response.StatusCode == System.Net.HttpStatusCode.Accepted)
            {
                statusMessage = $"✅ 202 Accepted! Order for item [{productId}] successfully passed API front gates and is now inside RabbitMQ broker queue line.";
                alertClass = "alert-success";

                // Keep the UI lively: locally decrement stock counter instantly for immediate user satisfaction feedback loop
                var targetItem = products?.FirstOrDefault(p => p.Id == productId);
                if (targetItem != null)
                {
                    targetItem.StockQuantity -= 1;
                }
            }
            else
            {
                statusMessage = $"⚠️ Queue boundary pipeline rejected command framework. StatusCode: {response.StatusCode}";
                alertClass = "alert-warning";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"❌ Transport connection error: {ex.Message}";
            alertClass = "alert-danger";
        }
        finally
        {
            activeProcessingIds.Remove(productId);
        }
    }

    // Mutable proxy class properties to allow real-time local display decrements
    public class ProductDisplayDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int StockQuantity { get; set; }
        public string ImageUrl { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
    }
}
